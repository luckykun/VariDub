{
  "name": "varidub",
  "version": "0.1.0",
  "description": "VariDub（综译）— 中文综艺片段 → 3D 动画 + 英文配音 的本地流水线桌面应用",
  "main": "./out/main/index.js",
  "author": "VariDub",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite start",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "postinstall": "electron-builder install-app-deps",
    "smoke": "electron-vite build && node scripts/smoke-test.mjs",
    "icon": "node scripts/make-icon.mjs",
    "sidecar:install": "powershell -File scripts/setup-sidecar.ps1",
    "sidecar:run": "powershell -File scripts/run-sidecar.ps1",
    "dist": "electron-vite build && electron-builder --dir",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@fastify/cors": "~10.0.1",
    "better-sqlite3": "~11.8.1",
    "drizzle-orm": "~0.36.4",
    "fastify": "~5.2.1",
    "ffmpeg-static": "~5.2.0",
    "fluent-ffmpeg": "~2.1.3",
    "openai": "~4.77.0",
    "wavesurfer.js": "~7.8.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "~4.1.0",
    "@types/better-sqlite3": "~7.6.12",
    "@types/fluent-ffmpeg": "~2.1.27",
    "@types/node": "~22.10.2",
    "@types/react": "~18.3.14",
    "@types/react-dom": "~18.3.2",
    "@vitejs/plugin-react": "~4.3.4",
    "electron": "~33.3.1",
    "electron-builder": "~25.1.8",
    "electron-vite": "~3.0.0",
    "lucide-react": "~0.468.0",
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "tailwindcss": "~4.1.0",
    "typescript": "~5.7.2",
    "vite": "~5.4.11",
    "zustand": "~5.0.2"
  }
}
